#!name=GLaDOS 自动签到 v1.6.2 Loon
#!desc=GLaDOS / Railgun 自动签到 + 积分兑换｜四个账号独立开关｜关闭账号跳过运行｜账号对应邮箱见日志
#!author=GUIEROOR / Curtinp118
#!homepage=https://github.com/GUIEROOR/Scripthub
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/GlaDos.png
#!tag=Check-in
#!loon_version=3.5.1(983)

[Argument]
account1 = switch,true,type=boolean,tag=账号1参与签到,desc=首次运行按已保存账号顺序绑定邮箱和会员体系；对应邮箱见运行日志
account2 = switch,true,type=boolean,tag=账号2参与签到,desc=首次运行按已保存账号顺序绑定邮箱和会员体系；对应邮箱见运行日志
account3 = switch,true,type=boolean,tag=账号3参与签到,desc=首次运行按已保存账号顺序绑定邮箱和会员体系；对应邮箱见运行日志
account4 = switch,true,type=boolean,tag=账号4参与签到,desc=首次运行按已保存账号顺序绑定邮箱和会员体系；对应邮箱见运行日志

[Script]
http-request ^https://(glados\.network|railgun\.info|glados\.vip|glados\.one|glados\.space)/(console/account(?:[/?#].*)?|api/user/(?:status|points)(?:[?#].*)?)$ script-path=https://raw.githubusercontent.com/GUIEROOR/Scripthub/main/scripts/glados/glados-loon.js?v=1.6.2, requires-body=false, timeout=15, tag=GLaDOS抓包v1.6.2, enable=true
cron "30 6 * * *" then script("https://raw.githubusercontent.com/GUIEROOR/Scripthub/main/scripts/glados/glados-loon.js?v=1.6.2", {${account1}, ${account2}, ${account3}, ${account4}}) with timeout=120, tag="GLaDOS签到v1.6.2", enable=true

[MITM]
hostname = glados.network, railgun.info, glados.vip, glados.one, glados.space
