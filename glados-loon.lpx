[Script]
http-request ^https://(glados\.network|railgun\.info|glados\.vip|glados\.one|glados\.space)/(console/account(?:[/?#].*)?|api/user/(?:status|points)(?:[?#].*)?)$ script-path=https://raw.githubusercontent.com/GUIEROOR/Scripthub/main/scripts/glados/glados-loon.js, requires-body=false, timeout=15, tag=GLaDOS抓包v1.4, enable=true
cron "30 6 * * *" script-path=https://raw.githubusercontent.com/GUIEROOR/Scripthub/main/scripts/glados/glados-loon.js, timeout=120, tag=GLaDOS签到v1.4, enable=true

[MITM]
hostname = glados.network, railgun.info, glados.vip, glados.one, glados.space
